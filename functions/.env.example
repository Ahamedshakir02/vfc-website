# Cashfree Payments keys for online payment - copy to functions/.env and fill
# from the Cashfree merchant dashboard (Developers > API Keys).
# Never commit functions/.env.
#
# Start with the Test (sandbox) pair and CASHFREE_ENV=sandbox: the real payment
# page opens but no money moves. Switch to the Production pair and
# CASHFREE_ENV=production once the club's Cashfree account is approved.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
