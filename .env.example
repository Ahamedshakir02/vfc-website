# Firebase web app config - copy to .env.local and fill from the Firebase console.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The club's UPI ID, shown on the registration form. Optional: officers can set
# it at /admin (Club details), and what they save there is used instead.
VITE_CLUB_UPI_ID=

# Dev server only: set to true to use the local Firebase emulators
# (npm run emulators) instead of a real project. The Firebase values above are
# then not needed. Ignored by production builds. `npm run demo` sets this
# itself, so there is normally no need to.

# The payment gateway's keys are not set here: they belong to the server side,
# in functions/.env (see functions/.env.example).
VITE_FIREBASE_EMULATORS=
