# Firebase web app config - copy to .env.local and fill from the Firebase console.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The club's UPI ID, shown on the registration form. Online registration stays
# switched off until this, the Firebase values above and the event's fee are set.
VITE_CLUB_UPI_ID=

# Dev server only: set to true to use the local Firebase emulators
# (npm run emulators) instead of a real project. The Firebase values above are
# then not needed. Ignored by production builds.
VITE_FIREBASE_EMULATORS=
