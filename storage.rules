rules_version = '2';

// Not deployed automatically. Review, then: firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {

    // Payment screenshots: anyone may upload one image up to 5 MB to a new
    // path. Only club officers (an /admins document in Firestore, see
    // firestore.rules) can open them, and nobody can replace or delete them.
    match /payment-screenshots/{eventId}/{file} {
      allow create: if request.resource.size < 5 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');
      allow read: if request.auth != null
          && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
      allow update, delete: if false;
    }

    // The site's own pictures (event covers, gallery photos, award photos):
    // anyone can see them, officers add and remove them.
    match /site/{folder}/{file} {
      allow read: if true;
      allow create: if request.auth != null
          && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
          && request.resource.size < 5 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
          && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
      allow update: if false;
    }
  }
}
