rules_version = '2';

// Not deployed automatically. Review, then: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // A club officer is a signed-in account with a document under /admins.
    function isOfficer() {
      return request.auth != null
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // The list of officers is kept in the Firebase console. An account may
    // only ask whether it is on the list itself; nobody can list or change it.
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Site content is public to read. It is edited in the Firebase console
    // until its admin screens exist, so no client may write it.
    match /events/{id} { allow read: if true; allow write: if false; }
    match /awards/{id} { allow read: if true; allow write: if false; }
    match /gallery/{id} { allow read: if true; allow write: if false; }

    // Anyone may add a registration, exactly once and only in the expected
    // shape. Only officers can read them, and the one thing an officer can
    // change is whether the payment has been verified. Nobody can delete one.
    match /registrations/{id} {
      allow create: if request.resource.data.keys().hasOnly([
            'eventId', 'name', 'phone', 'email', 'category', 'teamName',
            'paymentRef', 'paymentScreenshotPath', 'paymentStatus', 'createdAt'
          ])
          && request.resource.data.eventId is string
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 120
          && request.resource.data.phone.matches('^[6-9][0-9]{9}$')
          && request.resource.data.email is string
          && request.resource.data.email.size() <= 200
          && request.resource.data.category is string
          && request.resource.data.teamName is string
          && request.resource.data.teamName.size() <= 120
          && request.resource.data.paymentRef.matches('^[A-Za-z0-9]{8,35}$')
          && request.resource.data.paymentScreenshotPath.matches('^payment-screenshots/.+')
          && request.resource.data.paymentStatus == 'pending'
          && request.resource.data.createdAt == request.time;
      allow read: if isOfficer();
      allow update: if isOfficer()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentStatus'])
          && request.resource.data.paymentStatus in ['pending', 'verified'];
      allow delete: if false;
    }
  }
}
