rules_version = '2';

// Not deployed automatically. Review, then: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // A club officer is a signed-in account with a document under /admins.
    function isOfficer() {
      return request.auth != null
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // The list of officers is kept in the Firebase console. An account may
    // only ask whether it is on the list itself; nobody can list or change it.
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Site content is public to read and edited by officers at /admin.
    match /events/{id} {
      allow read: if true;
      allow delete: if isOfficer();
      // The fee is what the payment function charges, so it must be a whole
      // number of rupees or not set at all.
      allow create, update: if isOfficer()
          && request.resource.data.title.en is string
          && request.resource.data.title.en.size() > 0
          && request.resource.data.status in ['upcoming', 'open', 'closed']
          && (request.resource.data.fee == null
              || (request.resource.data.fee is int && request.resource.data.fee > 0));
    }
    match /awards/{id} { allow read: if true; allow write: if isOfficer(); }
    match /gallery/{id} { allow read: if true; allow write: if isOfficer(); }
    match /settings/{id} { allow read: if true; allow write: if isOfficer(); }

    // Online payments in progress belong to the Cloud Functions alone.
    match /orders/{id} { allow read, write: if false; }

    // Anyone may add a registration paid by UPI, exactly once, only in the
    // expected shape and only as "pending". (One paid online is written by a
    // Cloud Function, which is the only way to arrive already verified.) Only
    // officers can read them, and the one thing an officer can change is
    // whether the payment has been verified. Nobody can delete one.
    match /registrations/{id} {
      allow create: if request.resource.data.keys().hasOnly([
            'eventId', 'name', 'phone', 'email', 'category', 'teamName',
            'paymentMethod', 'paymentRef', 'paymentScreenshotPath', 'paymentStatus', 'createdAt'
          ])
          && request.resource.data.paymentMethod == 'upi'
          && request.resource.data.eventId is string
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 120
          && request.resource.data.phone.matches('^[6-9][0-9]{9}$')
          && request.resource.data.email is string
          && request.resource.data.email.size() <= 200
          && request.resource.data.category is string
          && request.resource.data.teamName is string
          && request.resource.data.teamName.size() <= 120
          && request.resource.data.paymentRef.matches('^[A-Za-z0-9]{8,35}$')
          && request.resource.data.paymentScreenshotPath.matches('^payment-screenshots/.+')
          && request.resource.data.paymentStatus == 'pending'
          && request.resource.data.createdAt == request.time;
      allow read: if isOfficer();
      allow update: if isOfficer()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentStatus'])
          && request.resource.data.paymentStatus in ['pending', 'verified'];
      allow delete: if false;
    }
  }
}
