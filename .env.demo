# Used only by `npm run demo`, which runs the site against the local Firebase
# emulators. Nothing here is a real credential: the account below exists only
# inside the emulators on this machine and is discarded when they stop.
VITE_FIREBASE_EMULATORS=true
VITE_DEMO_ADMIN_EMAIL=officer@vfc-demo.test
VITE_DEMO_ADMIN_PASSWORD=vfc-demo-officer
